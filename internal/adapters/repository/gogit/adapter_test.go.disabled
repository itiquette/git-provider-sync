// TestGoGitAdapter_ErrorHandling tests error conditions
func TestGoGitAdapter_ErrorHandling(t *testing.T) {
	adapter := NewAdapter()
	ctx := context.Background()

	// Test initializing repository in non-existent directory
	_, err := adapter.Init(ctx, "/non/existent/path", ports.InitOptions{})
	assert.Error(t, err, "Should fail to initialize in non-existent directory")

	// Test opening non-existent repository
	_, err = adapter.Open(ctx, "/non/existent/repo")
	assert.Error(t, err, "Should fail to open non-existent repository")

	// Test cleanup on non-existent path
	err = adapter.Cleanup(ctx, "/non/existent/path")
	assert.NoError(t, err, "Cleanup should not fail on non-existent path")
}

// TestGoGitAdapter_Concurrency tests concurrent operations
func TestGoGitAdapter_Concurrency(t *testing.T) {
	if testing.Short() {
		t.Skip("Skipping concurrency test in short mode")
	}

	adapter := NewAdapter()
	ctx := context.Background()

	// Create temporary directory
	tmpDir, err := os.MkdirTemp("", "gogit-concurrency-*")
	require.NoError(t, err)
	defer os.RemoveAll(tmpDir)

	// Test multiple repositories can be created concurrently
	numRepos := 5
	results := make(chan error, numRepos)

	for i := 0; i < numRepos; i++ {
		go func(index int) {
			repoPath := filepath.Join(tmpDir, "repo-"+string(rune('A'+index)))
			_, err := adapter.Init(ctx, repoPath, ports.InitOptions{Bare: false})
			results <- err
		}(i)
	}

	// Wait for all operations to complete
	for i := 0; i < numRepos; i++ {
		select {
		case err := <-results:
			assert.NoError(t, err, "Concurrent repository creation should succeed")
		case <-time.After(10 * time.Second):
			t.Fatal("Timeout waiting for concurrent repository creation")
		}
	}
}
