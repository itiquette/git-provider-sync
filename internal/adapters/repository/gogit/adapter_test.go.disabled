// TestGoGitAdapter_Integration provides comprehensive integration testing for the GoGit adapter
func TestGoGitAdapter_Integration(t *testing.T) {
	if testing.Short() {
		t.Skip("Skipping integration test in short mode")
	}

	tests := []struct {
		name     string
		testFunc func(t *testing.T, tmpDir string, adapter *Adapter)
	}{
		{
			name:     "init_and_basic_operations",
			testFunc: testInitAndBasicOperations,
		},
		{
			name:     "remote_management",
			testFunc: testRemoteManagement,
		},
		{
			name:     "branch_operations",
			testFunc: testBranchOperations,
		},
		{
			name:     "file_operations_and_status",
			testFunc: testFileOperationsAndStatus,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Create temporary directory for each test
			tmpDir, err := os.MkdirTemp("", "gogit-integration-*")
			require.NoError(t, err, "Failed to create temp directory")
			defer func() {
				err := os.RemoveAll(tmpDir)
				if err != nil {
					t.Logf("Warning: failed to cleanup temp directory %s: %v", tmpDir, err)
				}
			}()

			// Create adapter
			adapter := NewAdapter()

			tt.testFunc(t, tmpDir, adapter)
		})
	}
}

// testInitAndBasicOperations tests repository initialization and basic info operations
func testInitAndBasicOperations(t *testing.T, tmpDir string, adapter *Adapter) {
	ctx := context.Background()
	repoPath := filepath.Join(tmpDir, "test-repo")

	// Test repository initialization
	repo, err := adapter.Init(ctx, repoPath, ports.InitOptions{
		Bare: false,
	})
	require.NoError(t, err, "Should initialize repository")
	require.NotNil(t, repo, "Repository should not be nil")
	defer repo.Close()

	// Test basic repository info
	assert.Equal(t, repoPath, repo.Path(), "Repository path should match")
	assert.False(t, repo.IsBare(), "Repository should not be bare")
	assert.True(t, repo.IsClean(), "New repository should be clean")
	assert.False(t, repo.HasChanges(), "New repository should have no changes")

	// Test repository directory exists
	_, err = os.Stat(repoPath)
	assert.NoError(t, err, "Repository directory should exist")

	// Test .git directory exists
	gitDir := filepath.Join(repoPath, ".git")
	_, err = os.Stat(gitDir)
	assert.NoError(t, err, ".git directory should exist")
}

// testRemoteManagement tests remote add, remove, and list operations
func testRemoteManagement(t *testing.T, tmpDir string, adapter *Adapter) {
	ctx := context.Background()
	repoPath := filepath.Join(tmpDir, "remote-test-repo")

	// Initialize repository
	repo, err := adapter.Init(ctx, repoPath, ports.InitOptions{Bare: false})
	require.NoError(t, err, "Should initialize repository")
	defer repo.Close()

	// Test adding remotes
	originURL := "https://github.com/test/origin.git"
	err = repo.AddRemote(ctx, "origin", originURL)
	assert.NoError(t, err, "Should add origin remote")

	upstreamURL := "https://github.com/test/upstream.git"
	err = repo.AddRemote(ctx, "upstream", upstreamURL)
	assert.NoError(t, err, "Should add upstream remote")

	// Test listing remotes
	remotes, err := repo.ListRemotes(ctx)
	require.NoError(t, err, "Should list remotes")
	require.Len(t, remotes, 2, "Should have 2 remotes")

	// Verify remote details
	remoteMap := make(map[string]string)
	for _, remote := range remotes {
		remoteMap[remote.Name] = remote.URL
	}

	assert.Equal(t, originURL, remoteMap["origin"], "Origin URL should match")
	assert.Equal(t, upstreamURL, remoteMap["upstream"], "Upstream URL should match")

	// Test updating remote
	newOriginURL := "https://github.com/test/new-origin.git"
	err = repo.UpdateRemote(ctx, "origin", newOriginURL)
	assert.NoError(t, err, "Should update remote")

	// Verify remote was updated
	remotes, err = repo.ListRemotes(ctx)
	require.NoError(t, err, "Should list remotes after update")

	remoteMap = make(map[string]string)
	for _, remote := range remotes {
		remoteMap[remote.Name] = remote.URL
	}
	assert.Equal(t, newOriginURL, remoteMap["origin"], "Origin URL should be updated")

	// Test removing remote
	err = repo.RemoveRemote(ctx, "upstream")
	assert.NoError(t, err, "Should remove upstream remote")

	// Verify remote was removed
	remotes, err = repo.ListRemotes(ctx)
	require.NoError(t, err, "Should list remotes after removal")
	require.Len(t, remotes, 1, "Should have 1 remote after removal")
	assert.Equal(t, "origin", remotes[0].Name, "Remaining remote should be origin")
}

// testBranchOperations tests branch creation, checkout, and management
func testBranchOperations(t *testing.T, tmpDir string, adapter *Adapter) {
	ctx := context.Background()
	repoPath := filepath.Join(tmpDir, "branch-test-repo")

	// Initialize repository
	repo, err := adapter.Init(ctx, repoPath, ports.InitOptions{Bare: false})
	require.NoError(t, err, "Should initialize repository")
	defer repo.Close()

	// Create initial commit to have a proper main branch
	err = createInitialCommit(repoPath)
	require.NoError(t, err, "Should create initial commit")

	// Test current branch (should be main/master)
	currentBranch, err := repo.CurrentBranch()
	assert.NoError(t, err, "Should get current branch")
	assert.Contains(t, []string{"main", "master"}, currentBranch, "Current branch should be main or master")

	// Test listing branches
	branches, err := repo.ListBranches(ctx)
	assert.NoError(t, err, "Should list branches")
	assert.Len(t, branches, 1, "Should have 1 branch initially")
	assert.True(t, branches[0].IsCurrent, "Branch should be marked as current")

	// Test creating new branch
	err = repo.CreateBranch(ctx, "feature-branch", currentBranch)
	assert.NoError(t, err, "Should create feature branch")

	// Test listing branches after creation
	branches, err = repo.ListBranches(ctx)
	assert.NoError(t, err, "Should list branches after creation")
	assert.Len(t, branches, 2, "Should have 2 branches after creation")

	// Test checkout branch
	err = repo.CheckoutBranch(ctx, "feature-branch")
	assert.NoError(t, err, "Should checkout feature branch")

	// Verify current branch changed
	currentBranch, err = repo.CurrentBranch()
	assert.NoError(t, err, "Should get current branch after checkout")
	assert.Equal(t, "feature-branch", currentBranch, "Current branch should be feature-branch")

	// Test setting default branch
	err = repo.SetDefaultBranch(ctx, "feature-branch")
	assert.NoError(t, err, "Should set default branch")

	// Test deleting branch (checkout main first)
	err = repo.CheckoutBranch(ctx, "main")
	if err != nil {
		// Try master if main doesn't exist
		err = repo.CheckoutBranch(ctx, "master")
	}
	assert.NoError(t, err, "Should checkout main/master before deletion")

	err = repo.DeleteBranch(ctx, "feature-branch", false)
	assert.NoError(t, err, "Should delete feature branch")

	// Verify branch was deleted
	branches, err = repo.ListBranches(ctx)
	assert.NoError(t, err, "Should list branches after deletion")
	assert.Len(t, branches, 1, "Should have 1 branch after deletion")
}

// testFileOperationsAndStatus tests file operations and status checking
func testFileOperationsAndStatus(t *testing.T, tmpDir string, adapter *Adapter) {
	ctx := context.Background()
	repoPath := filepath.Join(tmpDir, "status-test-repo")

	// Initialize repository
	repo, err := adapter.Init(ctx, repoPath, ports.InitOptions{Bare: false})
	require.NoError(t, err, "Should initialize repository")
	defer repo.Close()

	// Test initial status (clean repository)
	status, err := repo.Status(ctx)
	assert.NoError(t, err, "Should get status")
	assert.True(t, status.IsClean, "Repository should be clean initially")
	assert.Empty(t, status.Modified, "Should have no modified files")
	assert.Empty(t, status.Added, "Should have no added files")
	assert.Empty(t, status.Deleted, "Should have no deleted files")
	assert.Empty(t, status.Untracked, "Should have no untracked files")

	// Create a test file
	testFile := filepath.Join(repoPath, "test.txt")
	err = os.WriteFile(testFile, []byte("Initial content"), 0644)
	require.NoError(t, err, "Should create test file")

	// Test status with untracked file
	status, err = repo.Status(ctx)
	assert.NoError(t, err, "Should get status with untracked file")
	assert.False(t, status.IsClean, "Repository should not be clean with untracked file")
	assert.Contains(t, status.Untracked, "test.txt", "Should show untracked file")

	// Create initial commit
	err = createInitialCommitWithFile(repoPath, "test.txt")
	require.NoError(t, err, "Should create initial commit")

	// Test status after commit (should be clean)
	status, err = repo.Status(ctx)
	assert.NoError(t, err, "Should get status after commit")
	assert.True(t, status.IsClean, "Repository should be clean after commit")

	// Modify the file
	err = os.WriteFile(testFile, []byte("Modified content"), 0644)
	require.NoError(t, err, "Should modify test file")

	// Test status with modified file
	status, err = repo.Status(ctx)
	assert.NoError(t, err, "Should get status with modified file")
	assert.False(t, status.IsClean, "Repository should not be clean with modified file")
	assert.Contains(t, status.Modified, "test.txt", "Should show modified file")

	// Test diff functionality
	diff, err := repo.Diff(ctx, ports.DiffOptions{})
	assert.NoError(t, err, "Should get diff")
	assert.NotEmpty(t, diff, "Diff should not be empty with modifications")
	assert.Contains(t, diff, "test.txt", "Diff should include modified file")
	assert.Contains(t, diff, "Modified content", "Diff should show new content")
}

// Helper functions

// createInitialCommit creates an initial commit in the repository
func createInitialCommit(repoPath string) error {
	// Create a README file
	readmeFile := filepath.Join(repoPath, "README.md")
	err := os.WriteFile(readmeFile, []byte("# Test Repository\n"), 0644)
	if err != nil {
		return err
	}

	return createInitialCommitWithFile(repoPath, "README.md")
}

