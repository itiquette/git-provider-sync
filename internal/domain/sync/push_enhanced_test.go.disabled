// TestPushToProviderUseCase_ExecuteEnhanced provides enhanced testing with better coverage
func TestPushToProviderUseCase_ExecuteEnhanced(t *testing.T) {
	tests := []struct {
		name           string
		setupMocks     func(*SharedMockRepositoryProvider, *SharedMockGitRepository, *SharedMockLogger)
		setupContext   func(context.Context) context.Context
		request        PushRequest
		expectedResult func(PushResponse) bool
		expectedError  bool
		description    string
	}{
		{
			name: "successful_push_with_protection_cycle",
			description: "Tests complete push workflow with protection disable/enable cycle",
			setupContext: func(ctx context.Context) context.Context {
				ctx, _ = filesystem.CreateTmpDir(ctx, "", "push_test_protection")
				return ctx
			},
			setupMocks: func(provider *SharedMockRepositoryProvider, gitRepo *SharedMockGitRepository, logger *SharedMockLogger) {
				// Mock basic git repo info
				gitRepo.On("Name").Return("test-repo")
				gitRepo.On("Path").Return("/tmp/test-repo")
				
				// Mock GPSUPSTREAM remote setup
				gitRepo.On("ListRemotes", mock.Anything).Return([]ports.RemoteInfo{
					{Name: "origin", URL: "https://github.com/source/test-repo.git"},
				}, nil).Once()
				gitRepo.On("RemoveRemote", mock.Anything, "GPSUPSTREAM").Return(nil)
				gitRepo.On("AddRemote", mock.Anything, "GPSUPSTREAM", "https://github.com/source/test-repo.git").Return(nil)
				gitRepo.On("ListRemotes", mock.Anything).Return([]ports.RemoteInfo{
					{Name: "origin", URL: "https://github.com/source/test-repo.git"},
					{Name: "GPSUPSTREAM", URL: "https://github.com/source/test-repo.git"},
				}, nil).Once()

				// Mock repository existence check
				provider.On("ProjectExists", mock.Anything, "target-user", "test-repo").Return(true, "existing-project-id", nil)

				// Mock protection disable/enable
				provider.On("Unprotect", mock.Anything, "main", "existing-project-id").Return(nil)
				provider.On("Protect", mock.Anything, "target-user", "main", "existing-project-id").Return(nil)

				// Mock push operation
				gitRepo.On("Push", mock.Anything, mock.MatchedBy(func(opts ports.PushOptions) bool {
					return opts.Remote == "origin" && opts.Force == false
				})).Return(nil)

				// Mock logger calls
				logger.On("Info", mock.Anything, mock.AnythingOfType("string"), mock.Anything).Maybe()
				logger.On("Debug", mock.Anything, mock.AnythingOfType("string"), mock.Anything).Maybe()
			},
			request: PushRequest{
				SourceRepository: createTestRepositoryEntity("test-repo"),
				SourceGitRepo:    &SharedMockGitRepository{},
				TargetConfig:     createTestMirrorTargetWithProtection("target-user", true),
				SourceConfig:     createTestProviderConfig(),
				ForcePush:        false,
				DryRun:           false,
				CreateIfMissing:  false,
			},
			expectedResult: func(response PushResponse) bool {
				return response.Success && !response.Created && response.ProjectID == "existing-project-id"
			},
			expectedError: false,
		},
		{
			name: "force_push_with_repository_creation",
			description: "Tests force push with automatic repository creation",
			setupContext: func(ctx context.Context) context.Context {
				ctx, _ = filesystem.CreateTmpDir(ctx, "", "push_test_force")
				return ctx
			},
			setupMocks: func(provider *SharedMockRepositoryProvider, gitRepo *SharedMockGitRepository, logger *SharedMockLogger) {
				// Mock GPSUPSTREAM remote setup
				gitRepo.On("ListRemotes", mock.Anything).Return([]ports.RemoteInfo{
					{Name: "origin", URL: "https://github.com/source/new-repo.git"},
				}, nil)
				gitRepo.On("RemoveRemote", mock.Anything, "GPSUPSTREAM").Return(nil)
				gitRepo.On("AddRemote", mock.Anything, "GPSUPSTREAM", "https://github.com/source/new-repo.git").Return(nil)
				gitRepo.On("ListRemotes", mock.Anything).Return([]ports.RemoteInfo{
					{Name: "origin", URL: "https://github.com/source/new-repo.git"},
					{Name: "GPSUPSTREAM", URL: "https://github.com/source/new-repo.git"},
				}, nil)

				// Mock repository does not exist
				provider.On("ProjectExists", mock.Anything, "target-user", "new-repo").Return(false, "", nil)

				// Mock repository creation
				provider.On("CreateRepositoryForPush", mock.Anything, mock.MatchedBy(func(req ports.CreateRepositoryRequest) bool {
					return req.Name == "new-repo" && strings.Contains(req.Description, "Git Provider Sync cloned")
				})).Return("new-project-id", nil)

				// Mock force push operation
				gitRepo.On("Push", mock.Anything, mock.MatchedBy(func(opts ports.PushOptions) bool {
					return opts.Remote == "origin" && opts.Force == true
				})).Return(nil)

				// Mock logger calls
				logger.On("Info", mock.Anything, mock.AnythingOfType("string"), mock.Anything).Maybe()
				logger.On("Debug", mock.Anything, mock.AnythingOfType("string"), mock.Anything).Maybe()
			},
			request: PushRequest{
				SourceRepository: createTestRepositoryEntityWithDescription("new-repo", "Original repository description"),
				SourceGitRepo:    &SharedMockGitRepository{},
				TargetConfig:     createTestMirrorTarget("target-user"),
				SourceConfig:     createTestProviderConfig(),
				ForcePush:        true,
				DryRun:           false,
				CreateIfMissing:  true,
			},
			expectedResult: func(response PushResponse) bool {
				return response.Success && response.Created && response.ProjectID == "new-project-id"
			},
			expectedError: false,
		},
		{
			name: "dry_run_simulation_accurate",
			description: "Tests dry run mode provides accurate simulation",
			setupContext: func(ctx context.Context) context.Context {
				return ctx // No tmp dir needed for dry run
			},
			setupMocks: func(provider *SharedMockRepositoryProvider, gitRepo *SharedMockGitRepository, logger *SharedMockLogger) {
				// No provider or git operations should be called in dry run
				logger.On("Info", mock.Anything, mock.AnythingOfType("string"), mock.Anything).Maybe()
				logger.On("Debug", mock.Anything, mock.AnythingOfType("string"), mock.Anything).Maybe()
			},
			request: PushRequest{
				SourceRepository: createTestRepositoryEntity("dry-run-repo"),
				SourceGitRepo:    &SharedMockGitRepository{},
				TargetConfig:     createTestMirrorTarget("target-user"),
				SourceConfig:     createTestProviderConfig(),
				ForcePush:        false,
				DryRun:           true,
				CreateIfMissing:  true,
			},
			expectedResult: func(response PushResponse) bool {
				return response.Success &&
					!response.Created &&
					response.ProjectID == "dry-run-project-id" &&
					strings.Contains(response.TargetURL, "target-user/dry-run-repo.git")
			},
			expectedError: false,
		},
		{
			name: "git_push_failure_handling",
			description: "Tests proper error handling when git push fails",
			setupContext: func(ctx context.Context) context.Context {
				ctx, _ = filesystem.CreateTmpDir(ctx, "", "push_test_fail")
				return ctx
			},
			setupMocks: func(provider *SharedMockRepositoryProvider, gitRepo *SharedMockGitRepository, logger *SharedMockLogger) {
				// Mock GPSUPSTREAM remote setup
				gitRepo.On("ListRemotes", mock.Anything).Return([]ports.RemoteInfo{
					{Name: "origin", URL: "https://github.com/source/fail-repo.git"},
				}, nil)
				gitRepo.On("RemoveRemote", mock.Anything, "GPSUPSTREAM").Return(nil)
				gitRepo.On("AddRemote", mock.Anything, "GPSUPSTREAM", "https://github.com/source/fail-repo.git").Return(nil)
				gitRepo.On("ListRemotes", mock.Anything).Return([]ports.RemoteInfo{
					{Name: "origin", URL: "https://github.com/source/fail-repo.git"},
					{Name: "GPSUPSTREAM", URL: "https://github.com/source/fail-repo.git"},
				}, nil)

				// Mock repository exists
				provider.On("ProjectExists", mock.Anything, "target-user", "fail-repo").Return(true, "fail-project-id", nil)

				// Mock push failure
				gitRepo.On("Push", mock.Anything, mock.Anything).Return(assert.AnError)

				// Mock logger calls
				logger.On("Info", mock.Anything, mock.AnythingOfType("string"), mock.Anything).Maybe()
				logger.On("Debug", mock.Anything, mock.AnythingOfType("string"), mock.Anything).Maybe()
				logger.On("Error", mock.Anything, mock.AnythingOfType("string"), mock.Anything).Maybe()
			},
			request: PushRequest{
				SourceRepository: createTestRepositoryEntity("fail-repo"),
				SourceGitRepo:    &SharedMockGitRepository{},
				TargetConfig:     createTestMirrorTarget("target-user"),
				SourceConfig:     createTestProviderConfig(),
				ForcePush:        false,
				DryRun:           false,
				CreateIfMissing:  false,
			},
			expectedResult: func(response PushResponse) bool {
				return !response.Success && response.Error != nil
			},
			expectedError: true,
		},
		{
			name: "missing_origin_remote_error",
			description: "Tests error handling when origin remote is missing",
			setupContext: func(ctx context.Context) context.Context {
				ctx, _ = filesystem.CreateTmpDir(ctx, "", "push_test_no_origin")
				return ctx
			},
			setupMocks: func(provider *SharedMockRepositoryProvider, gitRepo *SharedMockGitRepository, logger *SharedMockLogger) {
				// Mock no origin remote
				gitRepo.On("ListRemotes", mock.Anything).Return([]ports.RemoteInfo{}, nil)

				// Mock logger calls
				logger.On("Info", mock.Anything, mock.AnythingOfType("string"), mock.Anything).Maybe()
				logger.On("Debug", mock.Anything, mock.AnythingOfType("string"), mock.Anything).Maybe()
				logger.On("Error", mock.Anything, mock.AnythingOfType("string"), mock.Anything).Maybe()
			},
			request: PushRequest{
				SourceRepository: createTestRepositoryEntity("no-origin-repo"),
				SourceGitRepo:    &SharedMockGitRepository{},
				TargetConfig:     createTestMirrorTarget("target-user"),
				SourceConfig:     createTestProviderConfig(),
				ForcePush:        false,
				DryRun:           false,
				CreateIfMissing:  false,
			},
			expectedResult: func(response PushResponse) bool {
				return !response.Success && response.Error != nil
			},
			expectedError: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Setup context
			ctx := context.Background()
			if tt.setupContext != nil {
				ctx = tt.setupContext(ctx)
				// Cleanup tmp dir if created
				defer func() {
					if cleanupErr := filesystem.DeleteTmpDir(ctx); cleanupErr != nil {
						t.Logf("Failed to cleanup temp directory: %v", cleanupErr)
					}
				}()
			}

			// Create mocks
			mockProvider := &SharedMockRepositoryProvider{}
			mockGitRepo := &SharedMockGitRepository{}
			mockLogger := &SharedMockLogger{}

			// Setup test-specific mocks
			tt.setupMocks(mockProvider, mockGitRepo, mockLogger)

			// Create use case
			useCase := NewPushToProviderUseCase(mockProvider, nil, mockLogger)

			// Set git repo in request
			tt.request.SourceGitRepo = mockGitRepo

			// Execute
			result, err := useCase.Execute(ctx, tt.request)

			// Verify error expectation
			if tt.expectedError {
				require.Error(t, err, "Expected error for test: %s", tt.description)
			} else {
				require.NoError(t, err, "Unexpected error for test: %s", tt.description)
			}

			// Verify result expectations
			if tt.expectedResult != nil {
				require.True(t, tt.expectedResult(result), "Result validation failed for test: %s", tt.description)
			}

			// Verify all mocks were called as expected
			mockProvider.AssertExpectations(t)
			mockGitRepo.AssertExpectations(t)
			mockLogger.AssertExpectations(t)
		})
	}
}

// TestPushToProviderUseCase_TargetURLGeneration tests URL generation logic
func TestPushToProviderUseCase_TargetURLGeneration(t *testing.T) {
	tests := []struct {
		name           string
		sourceRepo     entities.Repository
		targetConfig   entities.MirrorTarget
		expectedURL    string
		expectedSubstr []string
	}{
		{
			name:       "https_with_token_authentication",
			sourceRepo: createTestRepositoryEntity("url-test-repo"),
			targetConfig: createTestMirrorTargetWithAuth("target-user", "test-token", "https"),
			expectedURL:  "https://git:test-token@github.com/target-user/url-test-repo.git",
			expectedSubstr: []string{"https://", "target-user", "url-test-repo.git"},
		},
		{
			name:       "https_without_token",
			sourceRepo: createTestRepositoryEntity("no-token-repo"),
			targetConfig: createTestMirrorTargetWithAuth("target-user", "", "https"),
			expectedURL:  "https://github.com/target-user/no-token-repo.git",
			expectedSubstr: []string{"https://", "target-user", "no-token-repo.git"},
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Create minimal use case for testing URL generation
			mockProvider := &SharedMockRepositoryProvider{}
			mockLogger := &SharedMockLogger{}
			useCase := NewPushToProviderUseCase(mockProvider, nil, mockLogger)

			// Create request
			request := PushRequest{
				SourceRepository: tt.sourceRepo,
				TargetConfig:     tt.targetConfig,
			}

			// Test URL generation
			ctx := context.Background()
			url := useCase.buildTargetURL(ctx, request)

			// Verify expected substrings are present
			for _, substr := range tt.expectedSubstr {
				assert.Contains(t, url, substr, "URL should contain substring: %s", substr)
			}

			// If specific URL expected, verify exact match
			if tt.expectedURL != "" {
				assert.Equal(t, tt.expectedURL, url, "URL should match expected value")
			}
		})
	}
}

// TestPushToProviderUseCase_DescriptionGeneration tests description building logic
func TestPushToProviderUseCase_DescriptionGeneration(t *testing.T) {
	tests := []struct {
		name              string
		sourceRepo        entities.Repository
		expectedContains  []string
		expectedNotEmpty  bool
	}{
		{
			name:       "repository_with_description",
			sourceRepo: createTestRepositoryEntityWithDescription("desc-repo", "Original description"),
			expectedContains: []string{
				"Git Provider Sync cloned this from:",
				"https://github.com/test/desc-repo.git",
				"Original description",
			},
			expectedNotEmpty: true,
		},
		{
			name:       "repository_without_description",
			sourceRepo: createTestRepositoryEntityWithDescription("no-desc-repo", ""),
			expectedContains: []string{
				"Git Provider Sync cloned this from:",
				"https://github.com/test/no-desc-repo.git",
			},
			expectedNotEmpty: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Create minimal use case for testing description generation
			mockProvider := &SharedMockRepositoryProvider{}
			mockLogger := &SharedMockLogger{}
			useCase := NewPushToProviderUseCase(mockProvider, nil, mockLogger)

			// Create request
			request := PushRequest{
				SourceRepository: tt.sourceRepo,
				TargetConfig:     createTestMirrorTarget("target-user"),
			}

			// Test description generation
			description := useCase.buildDescription(request)

			// Verify description is not empty if expected
			if tt.expectedNotEmpty {
				assert.NotEmpty(t, description, "Description should not be empty")
			}

			// Verify expected substrings are present
			for _, substr := range tt.expectedContains {
				assert.Contains(t, description, substr, "Description should contain: %s", substr)
			}

			// Verify no line breaks remain
			assert.NotContains(t, description, "\n", "Description should not contain line breaks")
			assert.NotContains(t, description, "\r", "Description should not contain carriage returns")
		})
	}
}

// Helper functions for enhanced testing

func createTestRepositoryEntityWithDescription(name, description string) entities.Repository {
	builder := entities.NewRepositoryBuilder()
	builder, _ = builder.WithName(name)
	builder, _ = builder.WithHTTPSURL("https://github.com/test/" + name + ".git")
	builder, _ = builder.WithSSHURL("git@github.com:test/" + name + ".git")
	builder, _ = builder.WithDefaultBranch("main")
	builder = builder.WithDescription(description)
	builder = builder.WithVisibility("public")
	builder = builder.WithLastActivityAt(time.Now())
	repo, _ := builder.Build()
	return repo
}

func createTestMirrorTargetWithProtection(owner string, disableProtection bool) entities.MirrorTarget {
	authConfig := entities.NewAuthConfigWithToken("test-token", "git")
	builder := entities.NewMirrorTargetBuilder()
	builder, _ = builder.WithName("test-target")
	builder, _ = builder.WithProvider("github")
	builder = builder.WithDomain("github.com")
	builder, _ = builder.WithOwner(owner)
	builder, _ = builder.WithPath("")
	builder = builder.WithAuth(authConfig)
	target, _ := builder.Build()
	return target
}

func createTestMirrorTargetWithAuth(owner, token, protocol string) entities.MirrorTarget {
	var authConfig entities.AuthConfig
	if token != "" {
		authConfig = entities.NewAuthConfigWithToken(token, "git")
	} else {
		authConfig = entities.NewAuthConfigWithToken("", "")
	}
	
	builder := entities.NewMirrorTargetBuilder()
	builder, _ = builder.WithName("test-target")
	builder, _ = builder.WithProvider("github")
	builder = builder.WithDomain("github.com")
	builder, _ = builder.WithOwner(owner)
	builder, _ = builder.WithPath("")
	builder = builder.WithAuth(authConfig)
	target, _ := builder.Build()
	return target
}