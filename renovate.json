{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for git-provider-sync - extends base Itiquette config",
  "extends": [
    "github>itiquette/.github:renovate-base.json"
  ],
  "packageRules": [
    {
      "description": "Label all Go module updates",
      "matchManagers": [
        "gomod"
      ],
      "addLabels": [
        "go",
        "dependencies"
      ]
    },
    {
      "description": "Go major updates require manual review",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major-update"
      ],
      "automerge": false
    },
    {
      "description": "Group GitHub.com dependencies together",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "/^github\\.com/"
      ],
      "groupName": "github.com dependencies"
    },
    {
      "description": "Group golang.org/x/* standard library packages",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "/^golang\\.org\\/x/"
      ],
      "groupName": "golang.org/x packages"
    },
    {
      "description": "Group koanf configuration library updates",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "/koanf/"
      ],
      "groupName": "koanf dependencies"
    },
    {
      "description": "Bump Go version in go.mod",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Auto-merge Go minor and patch updates after minimum release age",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!/^go$/"
      ],
      "groupName": "go dependencies",
      "automerge": true
    }
  ]
}