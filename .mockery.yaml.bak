# Mockery v2.53+ configuration for hexagonal architecture
# Generates mocks for domain ports (interfaces)

with-expecter: true
disable-version-string: true
issue-845-fix: true
resolve-type-alias: false

packages:
  itiquette/git-provider-sync/internal/domain/ports:
    interfaces:
      Logger:
        mockname: MockLogger
        filename: MockLogger.go
        outpkg: mockhexagonal
        dir: generated/mocks/mockhexagonal
      GitOperations:
        mockname: MockGitOperations
        filename: MockGitOperations.go
        outpkg: mockhexagonal
        dir: generated/mocks/mockhexagonal
      RepositoryProvider:
        mockname: MockRepositoryProvider
        filename: MockRepositoryProvider.go
        outpkg: mockhexagonal
        dir: generated/mocks/mockhexagonal
      Configuration:
        mockname: MockConfiguration
        filename: MockConfiguration.go
        outpkg: mockhexagonal
        dir: generated/mocks/mockhexagonal